# ===========================================================================
# Fog Archives — environment template
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust as needed:   cp .env.example .env
# A working .env with these same defaults is also included in release ZIPs so a
# fresh install runs immediately. CHANGE the passwords/secret before production
# (see the "Environment Configuration" section in docs/docker-deployment.md).
# ===========================================================================

# --- Docker Compose deployment (read by `docker compose`) ------------------

# Postgres password for the bundled database (compose service: postgres).
# Also interpolated into the container's DATABASE_URL. CHANGE FOR PRODUCTION.
POSTGRES_PASSWORD="change-me-strong-password"

# Secret for signing/secret use. Consumed by compose and passed to the app.
# (Sessions currently use random opaque tokens hashed in the DB, so the code
# doesn't read this yet, but compose requires it and future features may.)
# Generate your own: `openssl rand -hex 32`. CHANGE FOR PRODUCTION.
SESSION_SECRET="replace-with-output-of-openssl-rand-hex-32"

# Public base URL (absolute links / metadata). Set to your real origin in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000/"

# Mark the session cookie Secure (HTTPS-only). Keep "false" on plain HTTP
# (e.g. http://SERVER_IP:3000) — browsers DROP Secure cookies over HTTP, which
# breaks login. Set "true" only behind HTTPS / a TLS reverse proxy.
SESSION_COOKIE_SECURE="false"

# Auto-bootstrap demo content on container boot (migrate + seed + import).
# Set "false" to apply the schema only and import manually.
BOOTSTRAP_DEMO="true"

# Seed admin account (created by `pnpm db:seed`). CHANGE THE PASSWORD FOR PROD.
LOCAL_ADMIN_USERNAME="admin"
LOCAL_ADMIN_PASSWORD="change-me-admin-password"

# --- Local (non-Docker) development only -----------------------------------

# When running the app directly with pnpm (not Compose), point at your local DB.
# In Docker this is provided by compose as postgresql://dbd:<pw>@postgres:5432/dbd
# and this value is ignored. CHANGE credentials/host for production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dbd"

# --- Optional: asset import script (pnpm import:assets) ---------------------
# Alternatives to the --pack / --dir CLI flags. Leave unset for normal use.
# IMPORT_PACK="dbd-icons-pack-1"
# IMPORT_PACK_DESC="DBD icon pack"
# IMPORT_PACK_DIR="data/assets/packs/dbd-icons-pack-1"

# Build-time only: in-build type-check + lint strictness. Default "true".
# On low-memory hosts (e.g. Raspberry Pi) these can be OOM-killed during
# `docker compose build`, leaving no Next.js standalone output. Set to "false"
# to build lean (run `pnpm typecheck` / `pnpm lint` separately).
NEXT_STRICT_BUILD="true"
# Build-time only: cap V8's heap (MB) for `next build`. Empty = Node default.
# In low-memory mode (NEXT_STRICT_BUILD=false) this auto-defaults to 4096 so a
# Raspberry Pi can finish the compile using swap. Raise (e.g. 6144) if it still OOMs.
NODE_BUILD_MEMORY=""
